<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="480.0" styleClass="root" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="de.davidschwietz.expensetracker.controller.MainController">
    <children>
        <HBox prefHeight="60.0" prefWidth="480.0">
            <children>
                <Region prefHeight="200.0" prefWidth="10.0" />
                <Label prefHeight="53.0" prefWidth="314.0" styleClass="title-label" text="Expense Tracker" />
            </children>
        </HBox>
        <HBox prefHeight="50.0" prefWidth="400.0" styleClass="toolbar">
            <children>
                <Region prefHeight="200.0" prefWidth="10.0" />
                <Button fx:id="addTransactionButton" mnemonicParsing="false" onAction="#handleAddTransaction" prefHeight="25.0" prefWidth="230.0" styleClass="add-button" text="+ Transaction" HBox.hgrow="ALWAYS" />
                <Button fx:id="addCategoryButton" mnemonicParsing="false" onAction="#handleAddCategory" prefHeight="25.0" prefWidth="230.0" styleClass="add-button" text="+ Category" HBox.hgrow="ALWAYS" />
                <Region prefHeight="29.0" prefWidth="200.0" />
                <TextField fx:id="searchField" prefHeight="25.0" prefWidth="230.0" promptText="Search" styleClass="search-field" HBox.hgrow="ALWAYS" />
                <Region prefHeight="200.0" prefWidth="10.0" />
            </children>
        </HBox>
        <HBox prefHeight="100.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
            <children>
                <Region prefHeight="200.0" prefWidth="10.0" />
                <TableView fx:id="transactionTable" editable="true" prefHeight="340.0" prefWidth="460.0" styleClass="transaction-table" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dateColumn" prefWidth="75.99996948242188" text="Date" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="136.66668701171875" text="Description" />
                        <TableColumn fx:id="categoryColumn" minWidth="0.0" prefWidth="86.66668701171875" text="Category" />
                        <TableColumn fx:id="typeColumn" prefWidth="84.6666259765625" text="Type" />
                        <TableColumn fx:id="amountColumn" prefWidth="73.3333740234375" text="Amount" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <Region prefHeight="200.0" prefWidth="10.0" />
            </children>
        </HBox>
        <Region prefHeight="15.0" prefWidth="200.0" />
        <HBox prefHeight="70.0" prefWidth="200.0">
            <children>
                <Region prefHeight="200.0" prefWidth="10.0" />
                <Separator orientation="VERTICAL" prefHeight="200.0" />
                <VBox prefHeight="81.0" prefWidth="138.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label prefHeight="17.0" prefWidth="97.0" text="Income" />
                        <Label fx:id="incomeLabel" prefHeight="17.0" prefWidth="140.0" text="0.00€" />
                    </children>
                </VBox>
                <Separator orientation="VERTICAL" prefHeight="200.0" />
                <VBox prefHeight="100.0" prefWidth="138.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label prefHeight="17.0" prefWidth="75.0" text="Expenses" />
                        <Label fx:id="expensesLabel" prefHeight="17.0" prefWidth="140.0" text="0.00€" />
                    </children>
                </VBox>
                <Separator orientation="VERTICAL" prefHeight="200.0" />
                <VBox prefHeight="81.0" prefWidth="138.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label prefHeight="17.0" prefWidth="79.0" text="Balance" />
                        <Label fx:id="balanceLabel" prefHeight="17.0" prefWidth="140.0" text="0.00€" />
                    </children>
                </VBox>
                <Region prefHeight="200.0" prefWidth="10.0" />
            </children>
        </HBox>
    </children>
</VBox>
